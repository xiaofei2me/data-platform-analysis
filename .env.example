# ============================================================
# Alibaba Cloud Credentials
# ============================================================

# 阿里云 AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=


# ============================================================
# DataWorks
# ============================================================

# DataWorks 所在地域
#
# 示例：
# cn-shanghai
# cn-hangzhou
# ap-northeast-1
DATAWORKS_REGION=cn-shanghai

# DataWorks 工作空间列表（JSON 数组）。
#
# 每个条目：
#   id                 DataWorks Workspace ID（稳定主键）
#   name               人类可读名称（数组内唯一）
#   maxcompute_project 1:1 绑定的 MaxCompute 项目（仅作环境映射元数据）
#
# 单 Workspace 即长度为 1 的数组。
# 启动时校验：JSON 非法、缺字段、重复 id 或重复 name 会直接失败。
DATAWORKS_WORKSPACES=[{"id": 123456, "name": "ws-a", "maxcompute_project": "maxcompute-project-a"}]

# DataWorks API 分页大小。
DATAWORKS_PAGE_SIZE=100

# DataWorks API 请求失败后的最大重试次数。
DATAWORKS_MAX_RETRIES=3


# ============================================================
# MaxCompute
# ============================================================

# MaxCompute 项目名称。
MAXCOMPUTE_PROJECT=

# MaxCompute Endpoint。
#
# 示例：
# http://service.cn-shanghai.maxcompute.aliyun.com/api
# https://service.cn-shanghai.maxcompute.aliyun.com/api
MAXCOMPUTE_ENDPOINT=

# MaxCompute Schema。
#
# 如果使用默认 Schema，可以留空。
MAXCOMPUTE_SCHEMA=


# ============================================================
# Export
# ============================================================

# Snapshot 数据保存目录。
SOURCE_DIR=source

# 是否覆盖已经存在的 Snapshot 文件。
EXPORT_OVERWRITE=true

# 是否采集 MaxCompute 实际分区实例。
#
# false：
#   只采集分区字段定义，例如 dt、ds。
#
# true：
#   同时采集实际存在的分区实例。
#
# 第一阶段建议保持 false。
MAXCOMPUTE_INCLUDE_PARTITIONS=false
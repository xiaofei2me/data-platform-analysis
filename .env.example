# ============================================================
# Alibaba Cloud Credentials
# ============================================================

# 阿里云 AccessKey
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=


# ============================================================
# DataWorks
# ============================================================

# DataWorks 所在地域
#
# 示例：
# cn-shanghai
# cn-hangzhou
# ap-northeast-1
DATAWORKS_REGION=cn-shanghai

# DataWorks Workspace 列表（JSON 数组）。
#
# 每个条目：
#   id    DataWorks Workspace ID（稳定主键）
#   name  Workspace 名称
#
# 当前约定：
#   Workspace name 与对应 MaxCompute Project name 1:1 对应。
#
# 单 Workspace 即长度为 1 的数组。
#
# 启动时校验：
#   - JSON 必须合法
#   - id 必须存在
#   - name 必须存在
#   - id 不能重复
#   - name 不能重复
WORKSPACES=[{"id": 123456, "name": "ods"}, {"id": 234567, "name": "dwd"}, {"id": 345678, "name": "ads"}]

# DataWorks API 分页大小。
DATAWORKS_PAGE_SIZE=100

# DataWorks API 请求失败后的最大重试次数。
DATAWORKS_MAX_RETRIES=3

# 需要获取的文件所属功能模块。
#
# NORMAL：数据开发
# MANUAL：手动任务
# MANUAL_BIZ：手动业务流程
# SKIP：数据开发的空跑调度
# ADHOCQUERY：临时查询
# COMPONENT：组件管理
#
# 多个类型使用逗号分隔。
#
# 如果不传入，则代表全部。
DATAWORKS_USE_TYPES=NORMAL


# ============================================================
# MaxCompute
# ============================================================

# MaxCompute Endpoint。
#
# 示例：
# http://service.cn-shanghai.maxcompute.aliyun.com/api
# https://service.cn-shanghai.maxcompute.aliyun.com/api
MAXCOMPUTE_ENDPOINT=

# MaxCompute Schema。
#
# 如果使用默认 Schema，可以留空。
MAXCOMPUTE_SCHEMA=

# 是否采集 MaxCompute 实际分区实例。
#
# false：
#   只采集分区字段定义，例如 dt、ds。
#
# true：
#   同时采集实际存在的分区实例。
#
# 第一阶段建议保持 false。
MAXCOMPUTE_INCLUDE_PARTITIONS=false


# ============================================================
# Export
# ============================================================

# Snapshot 数据保存目录。
SOURCE_DIR=source

# 是否覆盖已经存在的 Snapshot 文件。
EXPORT_OVERWRITE=true